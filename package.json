{
  "name": "vite-plugin-openapi-ts",
  "version": "1.0.11",
  "description": "A Vite plugin to generate TypeScript types and API client from OpenAPI specification",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openapi-ts": "./dist/src/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "vite",
    "plugin",
    "openapi",
    "typescript",
    "codegen",
    "api-client",
    "swagger"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "commander": "^14.0.2",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1"
  }
}
